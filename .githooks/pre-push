#!/bin/sh
# Refuses a push unless the tip commit of every pushed branch says whether CI
# should run: "[ci]" to run it, "[skip ci]" to skip it (GitHub Actions skips
# push and pull_request workflows on its own when it sees "[skip ci]").
# Enabled by `npm install` (see "prepare" in package.json).

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote branch pushes no commit.
  [ "$local_sha" = "$zero" ] && continue
  # Only branches trigger CI; tags are left alone.
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac

  if ! git log -1 --format=%B "$local_sha" | grep -qF -e "[ci]" -e "[skip ci]"; then
    echo "pre-push: the last commit on $remote_ref has no CI tag." >&2
    echo "  Add [ci] to run CI or [skip ci] to skip it, e.g. with git commit --amend:" >&2
    echo "    docs: fix a typo [skip ci]" >&2
    status=1
  fi
done

exit $status
