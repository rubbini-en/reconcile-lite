# Copy to .env and fill in. Never commit .env.

# Local Docker database (throwaway defaults from docker-compose.yml).
DATABASE_URL=postgres://reconcile:reconcile_local@127.0.0.1:54329/reconcile

# At least 32 characters each. Generate with: openssl rand -hex 32
FAKEPAY_WEBHOOK_SECRET=
REPORT_API_TOKEN=

# Optional, defaults to 3000.
PORT=3000

# Optional, defaults to 127.0.0.1 (loopback only).
HOST=127.0.0.1
